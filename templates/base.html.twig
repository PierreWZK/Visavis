<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Vis-à-vis · Deux voitures face à face, sans parti pris{% endblock %}</title>
        <meta name="description" content="{% block description %}Vis-à-vis aligne deux à quatre voitures caractéristique par caractéristique (prix, puissance, consommation, coffre, émissions) et met en évidence le meilleur de chaque ligne.{% endblock %}">
        {# Aperçu du lien quand on le partage (Open Graph, Twitter) #}
        <meta name="theme-color" content="#1a2039">
        <meta property="og:type" content="website">
        <meta property="og:locale" content="fr_FR">
        <meta property="og:site_name" content="Vis-à-vis">
        <meta property="og:title" content="{{ block('title') }}">
        <meta property="og:description" content="{{ block('description') }}">
        {# Adresse de référence : la page sans ses filtres (?q=, ?page=…), pour ne pas multiplier les doublons #}
        {% set canonical = block('canonical') is defined and block('canonical')|trim ? block('canonical')|trim : (app.current_route ? url(app.current_route, app.current_route_parameters) : app.request.uri) %}
        <meta property="og:url" content="{{ canonical }}">
        <link rel="canonical" href="{{ canonical }}">
        <meta property="og:image" content="{{ absolute_url('/og.png') }}">
        <meta property="og:image:width" content="1200">
        <meta property="og:image:height" content="630">
        <meta property="og:image:alt" content="Vis-à-vis · deux voitures face à face, ligne par ligne">
        <meta name="twitter:card" content="summary_large_image">
        {% block robots %}{% endblock %}
        {% block meta %}{% endblock %}
        <link rel="icon" href="/favicon.svg" type="image/svg+xml">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Work+Sans:wght@300;400;500&display=swap">
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        {% block page %}
            <header class="topbar">
                <a href="{{ path('app_home') }}" class="wordmark" aria-label="Vis-à-vis, accueil">Vis-à-vis</a>
                <nav class="topbar-links" aria-label="Navigation principale">
                    <a href="{{ path('app_catalog') }}" {{ app.current_route == 'app_catalog' ? 'aria-current="page"' }}>Catalogue</a>
                    <a href="{{ path('app_game') }}" {{ app.current_route == 'app_game' ? 'aria-current="page"' }}>Jeux du jour</a>
                </nav>
            </header>
            <main class="sheet">
                {% block body %}{% endblock %}
            </main>
            {{ include('_footer.html.twig') }}
        {% endblock %}
    </body>
</html>
