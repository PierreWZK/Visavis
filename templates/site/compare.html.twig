{% extends 'base.html.twig' %}
{% import 'site/_macros.html.twig' as m %}

{% block title %}{{ versions|length >= 2 ? versions|map(v => v.model ~ ' ' ~ v.name)|join(' vs ') ~ ' · ' }}Vis-à-vis{% endblock %}
{# Une comparaison par combinaison de voitures : à partager, pas à indexer (les fiches, elles, le sont) #}
{% block robots %}<meta name="robots" content="noindex, follow">{% endblock %}
{% block canonical %}{{ url('app_compare', {v: ids|join(',')}) }}{% endblock %}
{% block description %}{{ versions|length >= 2 ? 'Comparaison ligne par ligne : prix, puissance, consommation, coffre et émissions, le meilleur de chaque ligne en évidence.' : parent() }}{% endblock %}

{% block body %}
{% if versions|length < 2 %}
    <div class="title-row">
        <h1>Il faut au moins deux voitures</h1>
        <p>Choisissez de deux à quatre versions dans le catalogue pour les mettre face à face.</p>
    </div>
    <a class="btn" href="{{ path('app_catalog', {v: ids ? ids|join(',') : null}) }}">Ouvrir le catalogue</a>
{% else %}
    <div class="title-row title-row-split">
        <div>
            <h1>{{ versions|length }} voitures face à face</h1>
            <p>La meilleure valeur de chaque ligne est en rose. Les autres affichent leur écart avec elle.</p>
        </div>
        <div class="title-actions">
            {% if versions|length < 4 %}
                <a class="btn btn-quiet" href="{{ path('app_catalog', {v: ids|join(',')}) }}">Ajouter une voiture</a>
            {% endif %}
            <button class="btn" type="button" data-share-copy data-url="{{ url('app_compare', {v: ids|join(',')}) }}">Copier le lien</button>
        </div>
    </div>

    <table class="compare" style="--cols: {{ versions|length }}">
        <thead>
            <tr>
                <td></td>
                {% for v in versions %}
                    {% set others = ids|filter(id => id != v.id) %}
                    <th scope="col">
                        {% if v.model.hasImage %}
                            <figure class="compare-photo">
                                <img src="{{ v.model.imageUrl|commons_width(500) }}" srcset="{{ v.model.imageUrl|commons_width(330) }} 330w, {{ v.model.imageUrl|commons_width(500) }} 500w, {{ v.model.imageUrl|commons_width(960) }} 960w" sizes="(max-width: 760px) 45vw, 22vw" alt="{{ v.model.brand.name }} {{ v.model.name }}" width="500" height="375" loading="lazy">
                            </figure>
                        {% endif %}
                        <a class="compare-car" href="{{ path('app_version', {id: v.id}) }}">{{ m.version_title(v) }}</a>
                        <span class="compare-car-meta">{{ v.energy.label }} · {{ v.model.body.label }}</span>
                        {% if others|length >= 2 %}
                            <a class="compare-remove" href="{{ path('app_compare', {v: others|join(',')}) }}" aria-label="Retirer {{ v }}">Retirer</a>
                        {% endif %}
                    </th>
                {% endfor %}
            </tr>
        </thead>
        <tbody>
            {% for row in rows %}
                <tr>
                    <th scope="row">
                        {{ row.label }}
                        <small>
                            {%- if not row.comparable -%}{{ row.mixed ? 'énergies différentes, non départagé' : 'une seule valeur connue' }}
                            {%- else -%}{{ row.higherIsBetter ? 'le plus haut gagne' : 'le plus bas gagne' }}{{ row.mixed ? ', à énergie égale' }}
                            {%- endif -%}
                        </small>
                    </th>
                    {% for cell in row.cells %}
                        {% set v = versions[loop.index0] %}
                        <td class="{{ cell.best ? 'best' }}" data-car="{{ v.model }} {{ v.name }}">
                            <span class="value">{{ m.measure(cell.value, cell.unit, row.key == 'consumption' ? 1 : 0) }}</span>
                            {% if cell.best %}
                                <span class="gap">Meilleur</span>
                            {% elseif cell.gap is not null %}
                                {% set sign = row.higherIsBetter ? '−' : '+' %}
                                <span class="gap">{{ sign }}{{ m.value(row.key, cell.gap) }} {{ cell.unit }}{% if cell.gapPercent is not null %} · {{ sign }}{{ m.num(cell.gapPercent, 1) }} %{% endif %}</span>
                            {% endif %}
                        </td>
                    {% endfor %}
                </tr>
            {% endfor %}
            <tr class="info">
                <th scope="row">Boîte</th>
                {% for v in versions %}<td data-car="{{ v.model }} {{ v.name }}">{{ v.gearbox.label ?? '—' }}</td>{% endfor %}
            </tr>
            {% if versions|filter(v => v.model.seats)|length %}
                <tr class="info">
                    <th scope="row">Places</th>
                    {% for v in versions %}<td data-car="{{ v.model }} {{ v.name }}">{{ v.model.seats ?? '—' }}</td>{% endfor %}
                </tr>
            {% endif %}
            <tr class="info">
                <th scope="row">Source</th>
                {% for v in versions %}<td data-car="{{ v.model }} {{ v.name }}">{{ m.source(v) }}</td>{% endfor %}
            </tr>
        </tbody>
    </table>
    {% set photographed = [] %}
    {% for v in versions|filter(v => v.model.hasImage) %}
        {% if v.model.id not in photographed|map(p => p.id) %}{% set photographed = photographed|merge([v.model]) %}{% endif %}
    {% endfor %}
    {% if photographed %}
        <p class="footnote">Photos Wikimedia Commons, du modèle et pas forcément de cette version :
            {% for model in photographed %}<a href="{{ model.imagePage }}" target="_blank" rel="noopener">{{ model.brand.name }} {{ model.name }}</a> par {{ model.imageCredit }}{{ not loop.last ? ' · ' }}{% endfor %}.
        </p>
    {% endif %}
    <p class="footnote">Données ADEME (Car Labelling, Licence Ouverte) et catalogue de démonstration : consommations et émissions WLTP, prix catalogue. « — » : non fourni par la source. Vérifiez les chiffres auprès du constructeur avant d'acheter.</p>
{% endif %}
{% endblock %}
